# Python cache and compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.env.*

# IDE files and folders
.vscode/
.idea/
*.iml

# OS generated files
.DS_Store
Thumbs.db

# Git repository
.git/
.gitignore

# GitHub workflows and templates (not needed in production)
.github/

# Testing
tests/
pytest.ini
.coverage
htmlcov/
.tox/

# Documentation (usually not needed in production)
README.md
*.md
docs/

# Database files (these should be external to container)
database/
*.sqlite3
*.db

# Logs (should use external logging)
*.log
logs/
app/logs/

# Sensitive files
naemo-project-admin-key.json
*.pem
*.key

# Build artifacts
dist/
build/

# Monitoring data (should be external)
monitoring/grafana-data/
monitoring/prometheus-data/

# Docker files (not needed inside container)
Dockerfile
.dockerignore
docker-compose*.yml

# Other common excludes
*.tmp
*.temp
.cache/
node_modules/